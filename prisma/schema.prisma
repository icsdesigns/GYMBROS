// GymBros — esquema completo.
// El MVP usa un subconjunto; el resto de modelos (feed, logros, eventos)
// ya están definidos para que las fases 2+ no requieran migraciones dolorosas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Usuarios ----------

enum Role {
  USER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarUrl    String?
  gymStartDate DateTime?
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())

  // Racha de SEMANAS cumpliendo el plan (weeklyTargetDays). Se reinicia si falla una semana.
  currentStreak      Int       @default(0) // semanas consecutivas
  bestStreak         Int       @default(0) // mejor racha histórica (semanas)
  lastCompletedWeek  DateTime? // lunes (ISO) de la última semana cumplida
  lastAttendanceDate DateTime?

  // Último latido de la app abierta (para avisar de entrenos olvidados)
  lastSeenAt DateTime?

  // Semanas (lunes ISO) en las que ya se avisó de racha en peligro / perdida,
  // para no repetir el aviso cada día.
  streakWarnedWeek DateTime?
  streakLostWeek   DateTime?

  notifyPrefs Json @default("{}")

  // Posición actual dentro del plan de entrenamiento (índice del siguiente slot)
  planPosition Int @default(0)

  // Días de entrenamiento planificados por semana (0 = sin configurar)
  weeklyTargetDays Int @default(0)

  // (legado) El apartado Gym ya no se puede ocultar desde Ajustes
  investmentEnabled Boolean @default(true)

  // Gimnasio de referencia del apartado Gym (solo el nombre)
  gymName String?

  // Tutorial de bienvenida ya completado
  onboardingDone Boolean @default(false)

  // El plan cambió automáticamente y conviene revisar el orden
  planNeedsReview Boolean @default(false)

  routines          Routine[]
  workouts          Workout[]
  incidents         WorkoutIncident[]
  attendances       Attendance[]
  personalRecords   PersonalRecord[]
  bodyMetrics       BodyMetric[]
  pointEvents       PointEvent[]
  notifications     Notification[]
  achievements      UserAchievement[]
  feedItems         FeedItem[]
  feedLikes         FeedLike[]
  feedComments      FeedComment[]
  customExercises   Exercise[]           @relation("CustomExercises")
  feedbacks         Feedback[]
  planSlots         PlanSlot[]
  chatMessages      ChatMessage[]
  chatReactions     ChatReaction[]
  pollVotes         PollVote[]
  pollSnoozes       PollSnooze[]
  pushSubscriptions PushSubscription[]
  gymSubscription   GymSubscription?
  updatesSeen       UpdateSeen[]
  resetTokens       PasswordResetToken[]

  lastChatReadAt DateTime? // para el contador de mensajes no leídos

  // ---------- Grupos ----------
  // Un mismo perfil (con la MISMA información) puede pertenecer a varios grupos.
  memberships   GroupMember[]
  createdGroups Group[]       @relation("GroupCreator")

  /// Grupo que el usuario está mirando ahora mismo. Se guarda aquí y no en el
  /// token de sesión porque la sesión dura un año: cambiar de grupo tiene que
  /// notarse al instante y en todos los dispositivos.
  activeGroupId String?
  activeGroup   Group?  @relation("ActiveGroup", fields: [activeGroupId], references: [id], onDelete: SetNull)

  // ---------- Borrado de cuenta en dos fases ----------
  /// Momento en que el usuario pidió borrarse. Mientras no sea null el perfil
  /// desaparece de los grupos, pero TODA su información sigue intacta.
  /// Volver a iniciar sesión dentro del plazo de gracia lo cancela.
  deletionRequestedAt DateTime?
  /// Palabra aleatoria que hay que teclear para confirmar el borrado.
  deletionWord        String?

  @@index([activeGroupId])
  @@index([deletionRequestedAt])
}

// ---------- Grupos ----------

enum GroupRole {
  MEMBER
  ADMIN
}

/// Un grupo es el contorno de todo lo social: ranking, chat, encuestas, feed y
/// listado de miembros. Los datos personales (rutinas, entrenos, PRs, medidas)
/// pertenecen al usuario y viajan con él a todos los grupos donde esté.
model Group {
  id          String   @id @default(cuid())
  name        String
  /// Código que hay que introducir para unirse. Siempre en mayúsculas.
  code        String   @unique
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("GroupCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members      GroupMember[]
  chatMessages ChatMessage[]
  polls        Poll[]
  activeFor    User[]        @relation("ActiveGroup")
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  /// Hasta cuándo ha leído este miembro el chat de ESTE grupo (el chat es por
  /// grupo y un usuario puede estar en varios).
  lastChatReadAt DateTime?

  @@unique([groupId, userId])
  @@index([userId])
}

// ---------- Recuperación de contraseña ----------

/// Vale de un solo uso para restablecer la contraseña. Se entrega por push al
/// dispositivo del usuario o, si no tiene push, lo genera un admin a mano.
/// En la base solo vive el hash: el token original únicamente viaja en la URL.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ---------- Ejercicios ----------

enum MuscleGroup {
  PECHO
  ESPALDA
  HOMBRO
  BICEPS
  TRICEPS
  PIERNA
  GLUTEO
  CORE
  CARDIO
  OTRO
}

model Exercise {
  id          String      @id @default(cuid())
  name        String
  muscleGroup MuscleGroup
  // El ejercicio no se hace con peso (dominadas, plancha, cardio…): en el
  // entreno solo se piden repeticiones y el progreso se mide en reps.
  noWeight    Boolean     @default(false)
  createdById String? // null = catálogo global
  createdBy   User?       @relation("CustomExercises", fields: [createdById], references: [id], onDelete: Cascade)

  routineExercises RoutineExercise[]
  workoutExercises WorkoutExercise[]
  personalRecords  PersonalRecord[]

  @@unique([name, createdById])
  @@index([muscleGroup])
}

// ---------- Rutinas ----------

model Routine {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  color            String   @default("#22c55e")
  emoji            String   @default("💪")
  recommendedDays  Int[]    @default([]) // (legado, ya no se usa en la UI)
  timesPerWeek     Int      @default(1) // cuántos días a la semana se hace esta rutina
  inPlan           Boolean  @default(true) // incluida en el plan de entrenamiento
  order            Int      @default(0) // posición en el plan de entrenamiento (la fija el usuario)
  estimatedMinutes Int?
  isShared         Boolean  @default(false)
  clonedFromId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  exercises RoutineExercise[]
  workouts  Workout[]
  planSlots PlanSlot[]

  @@index([userId])
  @@index([isShared])
}

model RoutineExercise {
  id           String   @id @default(cuid())
  routineId    String
  routine      Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
  order        Int
  sets         Int      @default(3)
  reps         Int      @default(10)
  targetWeight Float?
  restSeconds  Int?     @default(90)
  notes        String?

  @@index([routineId])
}

// ---------- Entrenamientos ----------

model Workout {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId      String?
  routine        Routine?  @relation(fields: [routineId], references: [id], onDelete: SetNull)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  totalVolume    Float     @default(0) // kg totales levantados
  totalSets      Int       @default(0)
  totalReps      Int       @default(0)
  notes          String?
  startNotified  Boolean   @default(false) // ya se avisó al grupo de que empezó
  idleNotifiedAt DateTime? // último aviso de "entreno activo y app sin abrir"

  exercises WorkoutExercise[]
  incidents WorkoutIncident[]

  @@index([userId, startedAt])
}

model WorkoutExercise {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  order      Int

  sets WorkoutSet[]

  @@index([workoutId])
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  reps              Int             @default(0)
  weight            Float           @default(0)
  completed         Boolean         @default(false)
  touched           Boolean         @default(false) // false = valor precargado de la sesión anterior
  notes             String?
}

// Incidencia: corrección de una sesión ya guardada cuando se anotó mal algún
// valor. Guarda qué se tocó y qué se recalculó, porque una sesión corregida
// mueve puntos y PRs y sin rastro no hay forma de explicar el ranking.
model WorkoutIncident {
  id          String   @id @default(cuid())
  workoutId   String
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  reason      String?
  // [{ setId, exercise, setNumber, from: {reps, weight}, to: {reps, weight} }]
  changes     Json
  // Puntos netos aplicados al corregir (negativo si se retiraron)
  pointsDelta Int      @default(0)

  @@index([workoutId])
  @@index([userId, createdAt])
}

// ---------- Asistencia ----------

model Attendance {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime  @db.Date
  checkIn  DateTime  @default(now())
  checkOut DateTime?
  gymName  String?
  notes    String?

  @@unique([userId, date])
  @@index([userId, date])
}

// ---------- PRs ----------

model PersonalRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  weight     Float
  reps       Int      @default(1)
  date       DateTime @default(now())
  notes      String?
  isAuto     Boolean  @default(false) // detectado automáticamente al registrar un entreno

  @@index([userId, exerciseId, date])
}

// ---------- Métricas privadas (NUNCA expuestas a otros usuarios) ----------

model BodyMetric {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  weightKg     Float?
  bodyFatPct   Float?
  muscleMassKg Float?
  bmi          Float?
  waistCm      Float?
  chestCm      Float?
  armCm        Float?
  legCm        Float?
  neckCm       Float?
  hipCm        Float?
  notes        String?
  photoUrl     String? // preparado para fotos de progreso (Supabase Storage, fase 2)

  @@index([userId, date])
}

// ---------- Puntos y ranking ----------

enum PointType {
  ATTENDANCE // asistencia: +5 por haber entrenado (antes, "ir al gimnasio"; los históricos se conservan)
  WORKOUT_COMPLETED // series realizadas: 1 punto por serie (los históricos incluyen además el +5 de asistencia)
  NEW_PR // nuevo récord (legado: los PR ya no dan puntos, los concedidos se conservan)
  STREAK_7 // racha de 7 días
  ROUTINE_SHARED // compartir rutina
  STREAK_WEEK1 // racha: 1 semana cumplida (+15)
  STREAK_WEEK2 // racha: 2 semanas seguidas (+25)
  STREAK_WEEK3 // racha: 3 semanas seguidas (+35)
  STREAK_MONTH // racha: 1 mes seguido (+45)
  STREAK_CRACK // crack: cada semana extra por encima del mes (+45)
  WEEKLY_TARGET // (legado)
  GOAL_COMPLETED // (legado)
  CUSTOM // regla personalizada otorgada por el admin
  PROGRESS_WEEKLY // progreso semanal: ‰ del peso total de los ejercicios en verde (se concede los lunes)
}

// Reglas de puntuación configurables desde el panel de admin.
// - type != null: regla estándar disparada automáticamente (puntos editables, se puede desactivar)
// - type == null: regla personalizada que el admin otorga manualmente a un usuario
model PointRule {
  id      String     @id @default(cuid())
  type    PointType? @unique
  name    String
  points  Int
  enabled Boolean    @default(true)
}

model PointEvent {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   PointType
  points Int
  date   DateTime  @default(now())
  meta   Json?

  @@index([userId, date])
  @@index([date])
}

// ---------- Notificaciones ----------

enum NotificationType {
  FRIEND_PR
  RANKING_CHANGE
  STREAK
  GOAL
  PR
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  meta      Json?

  @@index([userId, read, createdAt])
}

// ---------- Gamificación (fase 2: UI; el backend ya otorga logros) ----------

enum Rarity {
  COMUN
  RARO
  EPICO
  LEGENDARIO
}

model Achievement {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String
  icon        String @default("🏆")
  rarity      Rarity @default(COMUN)

  users UserAchievement[]
}

model UserAchievement {
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now())

  @@id([userId, achievementId])
}

// ---------- Feed social (fase 2: likes/comentarios; los items ya se generan) ----------

enum FeedType {
  PR
  WORKOUT
  STREAK
  GOAL
  RANKING
  ROUTINE_SHARED
  ACHIEVEMENT
}

model FeedItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      FeedType
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  likes    FeedLike[]
  comments FeedComment[]

  @@index([createdAt])
}

model FeedLike {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedItemId String
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, feedItemId])
}

model FeedComment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedItemId String
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  text       String
  createdAt  DateTime @default(now())
}

// ---------- Feedback de los usuarios (mejoras y bugs) ----------

enum FeedbackStatus {
  OPEN
  RESOLVED
}

model Feedback {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  status    FeedbackStatus @default(OPEN)
  createdAt DateTime       @default(now())

  @@index([status, createdAt])
}

// ---------- Plan de entrenamiento (orden/alternancia de rutinas y descansos) ----------

// Secuencia ordenada que define qué toca cada día de entrenamiento.
// routineId == null significa día de descanso.
model PlanSlot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Int
  routineId String?
  routine   Routine? @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([userId, order])
}

// ---------- Chat de grupo ----------

model ChatMessage {
  id        String   @id @default(cuid())
  /// Null en los mensajes de sistema (p. ej. el anuncio de rachas de los lunes).
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
  /// Mensaje generado por la app, no escrito por un miembro.
  system    Boolean  @default(false)

  // Nullable solo por los mensajes anteriores a los grupos: el script
  // prisma/backfill-groups.ts los asigna al grupo original.
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  reactions ChatReaction[]

  @@index([groupId, createdAt])
  @@index([createdAt])
}

model ChatReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String

  @@unique([messageId, userId, emoji])
}

// ---------- Suscripciones push (un registro por dispositivo) ----------

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Suscripción del gimnasio (calculadora de inversión) ----------

model GymSubscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate        DateTime // día del primer pago
  periodMonths     Int      @default(1) // 1=mensual, 2=bimestral, 3=trimestral…
  price            Float // precio por periodo
  autoRenew        Boolean  @default(false) // sin esto, cada renovación se confirma a mano
  confirmedPeriods Int      @default(1) // periodos pagados confirmados (incluye el inicial)
}

// ---------- Encuestas del admin ----------

model Poll {
  id          String    @id @default(cuid())
  // Igual que en el chat: nullable por las encuestas previas a los grupos.
  groupId     String?
  group       Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  description String?
  options     String[]
  closed      Boolean   @default(false)
  publishAt   DateTime  @default(now()) // programación: ya / 22h / 10h
  notifiedAt  DateTime? // cuándo se avisó al grupo (null = pendiente)
  createdAt   DateTime  @default(now())

  votes   PollVote[]
  snoozes PollSnooze[]
}

// Aplazamientos de 30 min (máximo 3 por usuario y encuesta)
model PollSnooze {
  id     String    @id @default(cuid())
  pollId String
  poll   Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  count  Int       @default(0)
  until  DateTime?

  @@unique([pollId, userId])
}

model PollVote {
  id          String   @id @default(cuid())
  pollId      String
  poll        Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionIndex Int
  createdAt   DateTime @default(now())

  @@unique([pollId, userId])
}

// ---------- Novedades de la app ----------

enum UpdateReaction {
  LIKE // 👍 le ha gustado
  MEH // 🫠 sin más
}

// Marca de que un usuario ya vio una novedad, con su reacción. El catálogo de
// novedades NO vive en la base de datos: está en src/lib/updates.ts.
model UpdateSeen {
  id       String         @id @default(cuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  updateId String // id de la novedad en src/lib/updates.ts
  reaction UpdateReaction
  seenAt   DateTime       @default(now())

  @@unique([userId, updateId])
  @@index([updateId])
}

// Novedades publicadas. Una novedad del catálogo (src/lib/updates.ts) solo se
// muestra a los usuarios si su id está aquí; se publica desde Ajustes de admin.
model UpdatePublication {
  updateId      String   @id // id de la novedad en src/lib/updates.ts
  publishedAt   DateTime @default(now())
  publishedById String? // admin que la publicó (sin relación: no altera otras tablas)
}

// ---------- Plantillas de notificación (disparador fijo, contenido editable) ----------

model NotificationTemplate {
  code    String  @id // identificador del disparador
  title   String
  body    String?
  enabled Boolean @default(true)
}
